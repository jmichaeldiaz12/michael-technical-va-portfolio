# Public site URL (metadata, sitemap, OG). Optional on Vercel (auto-detected from VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL), but recommended once a custom domain exists.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Required. At least 32 random characters, e.g. run: openssl rand -hex 32  (or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
RATE_LIMIT_SALT=

# Resend — optional email notifications
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
CONTACT_NOTIFICATION_EMAIL=you@example.com
